/**
 * @fileoverview Firestore Security Rules for NCC application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model.
 * Admins and Managers have broad oversight, while Cadets are restricted to their own dossiers.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isManager() {
      return isAuthenticated() && request.auth.token.role == 'manager';
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    /**
     * @description User Profiles
     * - Individuals can read/write their own profiles.
     * - Admin/Manager can list and read all profiles for roster management.
     */
    match /users/{userId} {
      allow get: if isAdminOrManager() || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isAdminOrManager();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isAuthenticated() && request.auth.uid == userId) || isAdminOrManager();
      allow delete: if isManager();
    }

    /**
     * @description Training Camps & Events
     * - Publicly readable by authenticated personnel.
     * - Writable only by Admin/Manager.
     */
    match /camps/{campId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManager();
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrManager();
    }

    /**
     * @description Camp Registrations
     * - Cadets can read their own registrations and create new ones.
     * - Admin/Manager can oversee and process all registrations.
     */
    match /registrations/{registrationId} {
      allow read: if isAdminOrManager() || (isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdminOrManager();
    }

    /**
     * @description Event Registrations
     */
    match /eventRegistrations/{registrationId} {
      allow read: if isAdminOrManager() || (isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdminOrManager();
    }

    /**
     * @description Attendance Records
     * - Cadets can view their own history.
     * - Admin/Manager can mark and modify attendance.
     */
    match /attendance/{attendanceId} {
      allow read: if isAdminOrManager() || (isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid));
      allow create, update, delete: if isAdminOrManager();
    }

    /**
     * @description Audit Logs
     * - Only readable by Managers for system oversight.
     * - No client-side writes allowed.
     */
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow write: if false;
    }
  }
}